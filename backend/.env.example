PORT=5679
DATABASE_URL=mysql://huobao:huobao@127.0.0.1:3317/huobao_drama

# 生产用户端前端域名，多个域名用逗号分隔
# FRONTEND_ORIGIN=https://wanying.example.com
# 生产管理后台域名，多个域名用逗号分隔；后台域名应和用户端域名分开
# ADMIN_ORIGIN=https://admin.wanying.example.com

# 未设置 DATABASE_URL 时可改用分项配置。
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3317
# MYSQL_USER=huobao
# MYSQL_PASSWORD=huobao
# MYSQL_DATABASE=huobao_drama
# MYSQL_CONNECTION_LIMIT=10

# Optional. Defaults to ../data/static from compiled source location.
# STORAGE_PATH=../data/static

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios to the Seedance API (local /static paths
# are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# 生产必填：用于 AES-256-GCM 加密数据库中的 AI API Key，部署后不可随意更换
# API_KEY_ENCRYPTION_SECRET=

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}

# 腾讯云 COS（配置后上传和 AI 生成资源会镜像到 COS）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=your-bucket-1250000000
# COS_REGION=ap-guangzhou
# COS_PREFIX=wanying

# 微信支付 / 支付宝商户参数（配置 SDK 下单与回调后启用）
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_API_V3_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY=
# WECHAT_PLATFORM_PUBLIC_KEY=
# WECHAT_WEBHOOK_SECRET=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_RETURN_URL=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ALIPAY_WEBHOOK_SECRET=
# PAYMENT_NOTIFY_URL=https://your-domain.com/api/v1/recharge/webhooks
# ADMIN_PHONE=13800138000
# ADMIN_PASSWORD=生产环境请设置高强度管理员密码；开发环境默认 Admin@123456
