# WanVision / 万影工坊 production environment template.
# Copy to .env.production on the server and replace every placeholder before deployment.

COMPOSE_PROJECT_NAME=wanvision

# Public service origins
APP_BIND=127.0.0.1
APP_PORT=5679
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8081
FRONTEND_ORIGIN=https://wanying.example.com
ADMIN_ORIGIN=https://admin.wanying.example.com
PUBLIC_BASE_URL=https://wanying.example.com

# MySQL
MYSQL_DATABASE=huobao_drama
MYSQL_USER=huobao
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Backend security
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_SECRET=replace-with-64-hex-chars

# Initial super admin. Required in production. Change the password after first login.
ADMIN_PHONE=13800138000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Object storage, optional. Leave empty to use local ./data/static storage.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_PREFIX=wanying

# Payment, optional.
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_WEBHOOK_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_RETURN_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_WEBHOOK_SECRET=
PAYMENT_NOTIFY_URL=

# Build mirrors, optional.
NPM_REGISTRY=
APT_MIRROR=
